{
  "type": "module",
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "scripts": {
    "tailwind": "tailwindcss -i style/tailwind.css -o public/app.css --minify",
    "tailwind:watch": "tailwindcss -i style/tailwind.css -o public/app.css --watch",
    "dev": "npm run tailwind && (npm run tailwind:watch & trunk serve)"
  }
}