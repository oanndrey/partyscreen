{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PartyScreen",
  "version": "1.0.10",
  "identifier": "br.com.partyscreen.app",
  "build": {
    "beforeDevCommand": "npm run tailwind && trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run tailwind && trunk build --release --dist dist-release",
    "frontendDist": "../dist-release"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PartyScreen",
        "width": 1000,
        "height": 700,
        "minWidth": 520,
        "minHeight": 520,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Compartilhe sua tela com um código",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
