{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "partyscreen",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // Página web de quem assiste pelo navegador (build do Vue em ../dist)
  "assets": {
    "directory": "../dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SIGNALING", "class_name": "Signaling" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Signaling"] }]
}
